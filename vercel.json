{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://project-5debf56e-4eb1-4458-94b.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://project-5debf56e-4eb1-4458-94b.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/((?!__/auth|__/firebase|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
